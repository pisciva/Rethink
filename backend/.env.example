# Backend only. Use the same Supabase project as the Swift app.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional bounded Q3 interpretation; never used for validation.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=deepseek/deepseek-v4.1-flash-1017
# Native URLSession needs no Origin header. Add browser origins only for explicit clients.
ALLOWED_ORIGINS=
